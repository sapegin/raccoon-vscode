{
  "name": "raccoon-vscode",
  "private": true,
  "description": "Monorepo of Artem Sapegin's Visual Studio Code extensions",
  "license": "MIT",
  "author": {
    "name": "Artem Sapegin",
    "url": "https://sapegin.me/"
  },
  "workspaces": [
    "extensions/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "oxlint && oxfmt --check && npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "nano-staged": "1.0.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-config-raccoon": "10.9.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "nano-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "oxlint --fix",
    "*.{js,mjs,cjs,ts,tsx,css,html,json,jsonc,yml,md}": "oxfmt"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@vscode/vsce-sign": true,
    "esbuild": true,
    "fsevents": true
  }
}
