{
  "name": "raccoon-vscode",
  "private": true,
  "description": "Monorepo of Artem Sapegin's Visual Studio Code extensions",
  "license": "MIT",
  "author": {
    "name": "Artem Sapegin",
    "url": "https://sapegin.me/"
  },
  "workspaces": [
    "extensions/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "oxlint --fix && npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/vscode": "1.137.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "nano-staged": "1.0.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-config-raccoon": "10.8.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "nano-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "oxlint --fix",
    "*.{js,mjs,cjs,ts,tsx,css,html,json,jsonc,yml,md}": "oxfmt"
  },
  "engines": {
    "node": ">=24"
  }
}
